vtest "Test tcp vmod"

feature cmd "uname | grep Linux"

server s1 {
       rxreq
       txresp
} -start

vinyl v1 -vcl+backend {
	import tcp;

	sub vcl_deliver {
		set resp.http.a = tcp.get_estimated_rtt();
	}
} -start

client c1 {
	txreq -url "/"
	rxresp
	# Probably terribly brittle.
	# expect resp.http.a == "4.000"
}

client c1 -run
